%Miller-Rabin primility test for n with t trials
def mrprime(n,t):
 if n%2 == 0: return False
 if n in [2,3]: return True
 if n<=4: return False
 m=n-1
 k=0
 smo = False
 while m%2 == 0:
  k += 1; m /= 2
# Now n-1 =(2**k) * m with m odd
  for i in range(1,t):
   a=randrange(2,n-1)
   apow=modpower(a, m, n)
   if not (apow in [1, n-1]):
    smo = False
    for r in range(k-1):
     apow=(apow*apow)%n
     if apow == n-1:
      smo = True
      break
   if not ((apow in [1,n-1]) or smo):
    return False
  return True

