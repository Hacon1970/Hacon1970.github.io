%finds number of divisors of n between n and sqrt(n)
def isprime(n):
    s = 0 
    for k in range (2,sqrt(n)+1):
      if n%k == 0:
        s=s+1
    return s

def modpower(b,e,m):
  """modpower(b,e,m) = b^e mod m"""
  P = 1
  S = b
  while e > 0:
    r = e%2
    e = e/2
    if r == 1:
          P = P*S % m
    S = S*S % m
  return P

