from math import *

def primes(n):
   if n<=1:return[]
   X=range(3,n+1,2)
   P=[2]
   sqrt_n=sqrt(n)
   while len(X)>0 and X[0] <=sqrt_n:
      p = X[0]
      P.append(p)
      X=[a for a in X if a%p !=0]
   return P+X

